# ─────────────────────────────────────────────────────────────────────────────
# Azytion GemERP — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (use either DATABASE_URL or individual vars) ────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/zationgemerp
# Or use individual vars:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-strong-password
# MYSQL_DATABASE=zationgemerp
# MYSQL_POOL_SIZE=20

# ── Security (REQUIRED in production — generate strong random values) ────────
# openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
SECRET_KEY=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET

# ── API Route Secrets ────────────────────────────────────────────────────────
# Secret for the /api/cron/backup endpoint
CRON_SECRET=CHANGE_THIS_TO_A_CRON_SECRET

# Secret for the /api/setup endpoint (database initialisation)
SETUP_SECRET=CHANGE_THIS_TO_A_SETUP_SECRET

# ── Initial Users (production first-run only) ────────────────────────────────
# Set these on first deploy — they are INSERT IGNORE so they won't overwrite
# passwords changed through the UI
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_ADMIN_PASSWORD
SUPER_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_SUPER_ADMIN_PASSWORD

# ── File Uploads ─────────────────────────────────────────────────────────────
# Absolute path to writable directory for uploaded files
UPLOAD_DIR=/var/data/uploads

# ── Optional Features ────────────────────────────────────────────────────────
# Google Gemini API key for AI assistant
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
